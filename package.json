{
  "name": "ret",
  "productName": "Ret",
  "version": "0.1.12",
  "description": "A fast, multi-project desktop workbench for the Codex app-server.",
  "private": true,
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev-web.mjs",
    "dev:demo": "vite --config vite.demo.config.mts",
    "build": "vite build && node scripts/build-main.mjs",
    "build:demo": "vite build --config vite.demo.config.mts",
    "start": "npm run build && electron .",
    "start:alongside": "npm run build && electron . --ret-profile=ret-alongside",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gen:protocol": "node scripts/gen-protocol.mjs",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.301",
    "@noble/curves": "^2.4.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "bonjour-service": "^1.4.4",
    "dompurify": "^3.4.17",
    "electron": "^44.8.0",
    "electron-builder": "^26.17.0",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.58.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tar": "^7.5.22",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "dev.ret.workbench",
    "productName": "Ret",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json",
      "!node_modules/node-pty/{src,deps,third_party,scripts,typings}/**",
      "!node_modules/node-pty/prebuilds/!(${platform}-*)/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "ItsJustMeChris",
      "repo": "ret"
    }
  },
  "dependencies": {
    "monaco-editor": "0.57.0",
    "node-pty": "^1.1.0"
  }
}
